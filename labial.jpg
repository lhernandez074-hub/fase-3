@-webkit-keyframes shake {=20
  0%, 100% { transform: translateZ(0px); }
  10%, 30%, 50%, 70%, 90% { transform: translate3d(-20px, 0px, 0px); }
  20%, 40%, 60%, 80% { transform: translate3d(20px, 0px, 0px); }
}

@keyframes shake {=20
  0%, 100% { transform: translateZ(0px); }
  10%, 30%, 50%, 70%, 90% { transform: translate3d(-20px, 0px, 0px); }
  20%, 40%, 60%, 80% { transform: translate3d(20px, 0px, 0px); }
}

