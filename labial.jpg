ls-content-mobile .list-menu__item--link { color: rgb(42, 42, 42); font-wei=
ght: 400; font-size: 14px; line-height: 20px; letter-spacing: 0.4px; font-f=
amily: "Helvetica Neue LT Std Roman" !important; }

