  5% { transform: rotate3d(0, 0, 1, 15deg); }
  10% { transform: rotate3d(0, 0, 1, -10deg); }
  15% { transform: rotate3d(0, 0, 1, 5deg); }
  20% { transform: rotate3d(0, 0, 1, -5deg); }
  25%, 100% { transform: rotate3d(0, 0, 1, 0deg); }
}

