@-webkit-keyframes ht-wobble {=20
  25%, 0%, 100% { transform: translate3d(0px, 0px, 0px); }
  3% { transform: translate3d(-25%, 0px, 0px) rotate3d(0, 0, 1, -5deg); }
  7% { transform: translate3d(20%, 0px, 0px) rotate3d(0, 0, 1, 3deg); }
  11% { transform: translate3d(-15%, 0px, 0px) rotate3d(0, 0, 1, -3deg); }
  15% { transform: translate3d(10%, 0px, 0px) rotate3d(0, 0, 1, 2deg); }
  18% { transform: translate3d(-5%, 0px, 0px) rotate3d(0, 0, 1, -1deg); }
}

@keyframes ht-wobble {=20
  25%, 0%, 100% { transform: translate3d(0px, 0px, 0px); }
  3% { transform: translate3d(-25%, 0px, 0px) rotate3d(0, 0, 1, -5deg); }
  7% { transform: translate3d(20%, 0px, 0px) rotate3d(0, 0, 1, 3deg); }
  11% { transform: translate3d(-15%, 0px, 0px) rotate3d(0, 0, 1, -3deg); }
  15% { transform: translate3d(10%, 0px, 0px) rotate3d(0, 0, 1, 2deg); }
  18% { transform: translate3d(-5%, 0px, 0px) rotate3d(0, 0, 1, -1deg); }
}

.ht-wobble { animation-name: ht-wobble; }

@-webkit-keyframes ht-jello {=20
  5.6%, 50%, 0%, 100% { transform: translate3d(0px, 0px, 0px); }
  11.1% { transform: skewX(-12.5deg) skewY(-12.5deg); }
  16.6% { transform: skewX(6.25deg) skewY(6.25deg); }
  22.2% { transform: skewX(-3.125deg) skewY(-3.125deg); }
  27.7% { transform: skewX(1.5625deg) skewY(1.5625deg); }
  33.3% { transform: skewX(-0.78125deg) skewY(-0.78125deg); }
  38.8% { transform: skewX(0.390625deg) skewY(0.390625deg); }
  44.4% { transform: skewX(-0.195312deg) skewY(-0.195312deg); }
}

@keyframes ht-jello {=20
  5.6%, 50%, 0%, 100% { transform: translate3d(0px, 0px, 0px); }
  11.1% { transform: skewX(-12.5deg) skewY(-12.5deg); }
  16.6% { transform: skewX(6.25deg) skewY(6.25deg); }
  22.2% { transform: skewX(-3.125deg) skewY(-3.125deg); }
  27.7% { transform: skewX(1.5625deg) skewY(1.5625deg); }
  33.3% { transform: skewX(-0.78125deg) skewY(-0.78125deg); }
  38.8% { transform: skewX(0.390625deg) skewY(0.390625deg); }
  44.4% { transform: skewX(-0.195312deg) skewY(-0.195312deg); }
}

.ht-jello { animation-name: ht-jello; transform-origin: center center; }

@-webkit-keyframes ht-flip {=20
  0% { transform: perspective(400px) rotate3d(0, 1, 0, -360deg); animation-=
timing-function: ease-out; }
  5% { transform: perspective(400px) translate3d(0px, 0px, 150px) rotate3d(=
0, 1, 0, -190deg); animation-timing-function: ease-out; }
  6% { transform: perspective(400px) translate3d(0px, 0px, 150px) rotate3d(=
0, 1, 0, -170deg); animation-timing-function: ease-in; }
  10% { transform: perspective(400px) scale3d(0.95, 0.95, 0.95); animation-=
timing-function: ease-in; }
  12%, 100% { transform: perspective(400px); animation-timing-function: eas=
e-in; }
}

@keyframes ht-flip {=20
  0% { transform: perspective(400px) rotate3d(0, 1, 0, -360deg); animation-=
timing-function: ease-out; }
  5% { transform: perspective(400px) translate3d(0px, 0px, 150px) rotate3d(=
