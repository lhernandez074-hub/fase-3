.card--standard.card--media .card__inner .card__information, .card--standar=
d.card--text:not(.card--horizontal) > .card__content .card__heading, .card-=
-standard:not(.card--horizontal) > .card__content .card__badge, .card--stan=
dard.card--text.article-card > .card__content .card__information, .card--st=
andard > .card__content .card__caption { display: none; }

