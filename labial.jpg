: 32px; --mp-bg-transparent-padding: 8px 0; --mp-bg-white-padding: 8px 16px=
; }

.mp-code-wrapper { font-size: 14px; display: inline-flex; }

.mp-code-button { color: var(--andes-color-blue-500); text-decoration: unde=
rline; background: none; border-width: medium; border-style: none; border-c=
olor: currentcolor; border-image: none; cursor: pointer; padding: 0px; disp=
lay: flex; align-items: center; gap: 4px; font-size: 14px; }

.mp-feedback-text, .mp-feedback-icon { display: none; }

.mp-skeleton { width: 100%; height: 50px; background: rgb(224, 224, 224); b=
order-radius: 4px; animation: 1.5s ease-in-out 0s infinite normal none runn=
ing skeleton-loading; }

@keyframes skeleton-loading {=20
  0% { background-color: rgb(224, 224, 224); }
  50% { background-color: rgb(240, 240, 240); }
  100% { background-color: rgb(224, 224, 224); }
}

.mp-credits-modal--code { margin-top: 24px; display: flex; flex-direction: =
column; border-radius: 8px; border: 1px solid rgb(237, 237, 237); }

.mp-credits-modal--code__wrapper { display: flex; align-items: center; gap:=
 16px; padding: 22px 22px 14px; }

.mp-credits-modal--code__icon-wrapper { display: flex; align-items: center;=
 justify-content: center; width: 54px; height: 54px; border-radius: 50%; bo=
rder: 1px solid rgb(237, 237, 237); }

.mp-credits-modal--code__icon { width: 32px; height: 32px; }

.mp-credits-modal--code__text-wrapper { display: flex; flex-direction: colu=
mn; align-items: flex-start; gap: 4px; }

.mp-credits-modal--code__text { font-size: 20px; font-weight: 600; line-hei=
ght: 25px; color: rgb(0, 0, 0); }

.mp-credits-modal--code__description { font-size: 14px; font-weight: 400; l=
ine-height: 18px; color: rgba(0, 0, 0, 0.55); }

.mp-credits-modal--code__divider { width: calc(100% - 44px); margin: 0px au=
to; border: 1.34px dashed rgb(237, 237, 237); }

.mp-credits-modal--code__button-wrapper { padding: 12px 15px; }

.mp-credits-modal--code__button { width: 100%; padding: 8px 0px; border-rad=
ius: 5px; background-color: var(--andes-color-blue-500); border-width: medi=
um; border-style: none; border-color: currentcolor; border-image: none; cur=
sor: pointer; display: flex; align-items: center; justify-content: center; =
gap: 8px; }

.mp-credits-modal--code__button-text { font-size: 16px; font-weight: 600; l=
ine-height: 20px; color: rgb(255, 255, 255); }

.mp-content-tooltip { display: flex; align-items: center; max-width: 438px;=
 gap: 12px; border-radius: 6px; }

.mp-content-tooltip .mp-flex-column { display: flex; gap: 0px; flex-directi=
on: column; width: 100%; }

.mp-content-tooltip .mp-flex-column .mp-text-style { margin: 0px; padding: =
0px; font-size: 14px; line-height: 18px; text-align: left; color: rgb(26, 2=
6, 26); }

.mp-content-tooltip .mp-flex-column .mp-text-style .mp-text-link { margin: =
0px; padding: 0px; line-height: 20px; font-size: 14px; text-decoration: und=
erline; color: var(--andes-color-blue-500); }

button#mp-modal-open { outline: none; border-width: medium; border-style: n=
one; border-color: currentcolor; border-image: none; background: none; curs=
or: pointer; align-items: center; }

