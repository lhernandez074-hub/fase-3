@-webkit-keyframes bounce {=20
  0% { opacity: 0; transform: translateZ(0px); }
  20% { opacity: 1; transform: translateZ(0px); }
  40% { opacity: 1; transform: translate3d(0px, -30px, 0px); }
  43% { opacity: 1; transform: translate3d(0px, -30px, 0px); }
  53% { opacity: 1; transform: translateZ(0px); }
  70% { opacity: 1; transform: translate3d(0px, -15px, 0px); }
  80% { opacity: 1; transform: translateZ(0px); }
  90% { opacity: 1; transform: translate3d(0px, -4px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

