.ins-preview-wrapper, .ins-content-wrapper, .ins-preview-wrapper *, .ins-co=
ntent-wrapper * { box-sizing: border-box; }

.ins-preview-wrapper .ins-notification-content, .ins-content-wrapper .ins-n=
otification-content { background-size: 100% 100%; letter-spacing: normal !i=
mportant; }

.ins-preview-wrapper div { display: block; font-style: inherit; text-align:=
 inherit; }

.ins-preview-wrapper div, .ins-preview-wrapper img, .ins-preview-wrapper p,=
 .ins-preview-wrapper span, .ins-preview-wrapper a, .ins-preview-wrapper i =
{ border-radius: initial !important; }

.ins-preview-wrapper a, .ins-preview-wrapper a:active, .ins-preview-wrapper=
 a:hover { outline: 0px; text-decoration: none; color: initial; }

.ins-preview-wrapper form, .ins-preview-wrapper fieldset { margin: 0px !imp=
ortant; }

.ins-pos-top-left { top: 0px; left: 0px; transform: translate(0px); positio=
n: fixed; z-index: 2147483647; }

.ins-pos-top-center { top: 0px; left: 50%; transform: translate(-50%); posi=
tion: fixed; z-index: 2147483647; }

.ins-pos-top-right { top: 0px; right: 0px; transform: translate(0px); posit=
ion: fixed; z-index: 2147483647; }

.ins-pos-middle-left { top: 50%; left: 0px; transform: translateY(-50%); po=
sition: fixed; z-index: 2147483647; }

.ins-pos-middle-center { top: 50%; left: 50%; transform: translate(-50%, -5=
0%); position: fixed; z-index: 2147483647; }

.ins-pos-middle-right { top: 50%; right: 0px; transform: translateY(-50%); =
position: fixed; z-index: 2147483647; }

.ins-pos-bottom-left { left: 0px; bottom: 0px; transform: translate(0px); p=
osition: fixed; z-index: 2147483647; }

.ins-pos-bottom-center { left: 50%; bottom: 0px; transform: translate(-50%)=
; position: fixed; z-index: 2147483647; }

.ins-pos-bottom-right { bottom: 0px; right: 0px; transform: translate(0px);=
 position: fixed; z-index: 2147483647; }

#ins-frameless-overlay { position: fixed; z-index: 2147483646; width: 100%;=
 height: 100%; background-color: rgb(0, 0, 0); opacity: 0.6; top: 0px; left=
: 0px; cursor: pointer; }

.ins-validation-error { border: 1px solid red !important; }

[id*=3D"ins-required-text-"] { font-size: 12px; text-align: center; padding=
: 5px 0px; color: red; }

.ins-other-text { width: 100%; height: 45px; color: rgb(85, 85, 85); border=
-width: medium medium 1px; border-style: none none solid; border-color: cur=
rentcolor currentcolor rgb(212, 214, 212); border-image: none; box-sizing: =
border-box; margin-top: 5px; padding: 0px 15px; border-radius: 3px !importa=
nt; outline: none !important; }

.insider-prevent-scroll { height: 100%; width: 100%; position: fixed; overf=
low: hidden !important; }

@keyframes bounceAlphaOnRight {=20
  0% { opacity: 1; transform: translate(0px) scale(1); }
  5% { opacity: 0; transform: translate(-10px) scale(0.9); }
  6% { opacity: 0; transform: translate(10px) scale(0.9); }
  10% { opacity: 1; transform: translate(0px) scale(1); }
  15% { opacity: 1; transform: translate(0px) scale(1); }
}

@keyframes bounceAlphaOnLeft {=20
  0% { opacity: 1; transform: translate(0px) scale(1); }
  5% { opacity: 0; transform: translate(10px) scale(0.9); }
  6% { opacity: 0; transform: translate(-10px) scale(0.9); }
  10% { opacity: 1; transform: translate(0px) scale(1); }
  15% { opacity: 1; transform: translate(0px) scale(1); }
}

.ins-element-content input.ins-dynamic-input { text-align: left; }

.ins-input-error-text { width: 100%; text-align: left; }

@-webkit-keyframes shimmer {=20
  0% { background-position: -4rem top; }
  70% { background-position: 15rem top; }
  100% { background-position: 15rem top; }
}

@keyframes spin {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.ins-dynamic-country-code { border-right: 0px; border-left: 0px; top: 5px; =
left: 7px; position: absolute; color: rgb(0, 0, 0); }

.ins-dynamic-country-code select { appearance: none; border: 0px; height: 3=
5px; background-color: rgba(111, 107, 107, 0); position: absolute; top: 0px=
; left: 0px; opacity: 0; width: 100%; }

.ins-dynamic-country-code .ins-phone-country-code-content { margin-top: 6px=
; line-height: 21px; display: flex; }

.ins-dynamic-country-code .ins-phone-country-code-content span { position: =
relative; padding-right: 13px; font-weight: 700; color: rgb(0, 0, 0); font-=
size: 14px; }

.ins-dynamic-country-code .ins-phone-country-code-content span::after { con=
tent: ""; position: absolute; right: 0px; top: 5px; width: 7px; height: 7px=
; border-bottom: 1px solid rgb(170, 170, 170); border-left: 1px solid rgb(1=
70, 170, 170); transform: rotate(-45deg); }

.ins-dynamic-country-code .ins-phone-country-code-content i { font-size: 12=
px; color: rgb(72, 70, 70); font-style: normal; margin-left: 5px; }

.ins-dynamic-country-code + input { text-indent: 75px; }

.ins-dynamic-input-reference .ins-selectable-element { position: relative; =
}

.ins-dynamic-input-reference .ins-dynamic-input { font-size: 14px; }

.ins-trigger-absolute { position: absolute; }

.ins-trigger-fixed, .ins-trigger-fixed-active { position: fixed; }

.ins-trigger-position-left { left: 0px; }

.ins-trigger-position-right { right: 0px; }

.ins-trigger-position-top { top: 0px; }

.ins-trigger-position-bottom { bottom: 0px; }

