-400-500-600-700.woff2.css");

body { --andes-color-yellow-500: #ffe600; --andes-color-blue-100: rgba(65, =
137, 230, 0.1); --andes-color-blue-150: rgba(65, 137, 230, 0.15); --andes-c=
olor-blue-200: rgba(65, 137, 230, 0.2); --andes-color-blue-300: rgba(65, 13=
7, 230, 0.3); --andes-color-blue-400: rgba(65, 137, 230, 0.4); --andes-colo=
r-blue-500: #3483fa; --andes-color-blue-600: #2968c8; --andes-color-blue-70=
0: #1f4e96; --andes-color-blue-800: #183c73; --andes-color-fill-brand: var(=
--andes-color-yellow-500); --andes-color-text-brand: rgba(0, 0, 0, 0.9); --=
