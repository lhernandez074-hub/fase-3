order-top-style: none; border-left-width: 1px; border-left-style: solid; bo=
rder-color: var(--jdgm-secondary-color); text-align: left; }
}

.jdgm-widget .jdgm-verified-checkmark { width: 17px; height: 17px; }

.jdgm-revs-tab-btn { position: fixed; display: inline-block; width: auto; c=
ursor: pointer; border-radius: 0px; white-space: nowrap; }

.jdgm-revs-tab-btn:hover { opacity: 0.8; }

.jdgm-revs-tab-btn[position=3D"bottom"] { bottom: 0px; }

.jdgm-revs-tab-btn[position=3D"left"] { left: 0px; }

.jdgm-revs-tab-btn[position=3D"right"] { right: 0px; }

.jdgm-revs-tab-btn[position=3D"none"] { display: none; }

.jdgm-revs-tab-btn[data-style=3D"text"][position=3D"bottom"] { left: 50%; t=
ransform: translateX(-50%); }

.jdgm-revs-tab-btn[data-style=3D"text"][position=3D"left"] { top: 50%; tran=
sform-origin: 0px 50%; transform: rotate(-90deg) translate(-50%, 50%); }

.jdgm-revs-tab-btn[data-style=3D"text"][position=3D"right"] { top: 50%; tra=
nsform-origin: 100% center; transform: rotate(90deg) translate(50%, 50%); }

.jdgm-revs-tab-btn[data-style=3D"stars"] { display: flex; }

.jdgm-revs-tab-btn[data-style=3D"stars"] .jdgm-favicon, .jdgm-revs-tab-btn[=
data-style=3D"stars"] .jdgm-rating, .jdgm-revs-tab-btn[data-style=3D"stars"=
] .jdgm-star { display: inline-block; width: 24px; }

.jdgm-revs-tab-btn[data-style=3D"stars"] .jdgm-favicon, .jdgm-revs-tab-btn[=
data-style=3D"stars"] .jdgm-favicon > span { display: flex; justify-content=
: center; }

.jdgm-revs-tab-btn[data-style=3D"stars"] .jdgm-rating { line-height: 1; fon=
t-weight: bold; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"bottom"] { align-items=
: center; padding: 8px 16px; left: calc(50% - 100px); box-shadow: rgba(0, 0=
, 0, 0.15) 4px 0px 20px; border-radius: 10px 10px 0px 0px; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"bottom"] .jdgm-stars {=
 display: inline-block; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"bottom"] .jdgm-favicon=
 + .jdgm-stars, .jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"bottom=
"] .jdgm-stars + .jdgm-rating { margin-left: 8px; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"left"] { box-shadow: r=
gba(0, 0, 0, 0.15) 4px 0px 20px; border-radius: 0px 10px 10px 0px; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"right"] { box-shadow: =
rgba(0, 0, 0, 0.15) 0px 4px 20px; border-radius: 10px 0px 0px 10px; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"left"], .jdgm-revs-tab=
-btn[data-style=3D"stars"][position=3D"right"] { flex-direction: column; to=
p: calc(50% - 100px); padding: 16px 8px; text-align: center; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"left"] .jdgm-favicon +=
 .jdgm-stars, .jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"left"] .=
jdgm-stars + .jdgm-rating, .jdgm-revs-tab-btn[data-style=3D"stars"][positio=
n=3D"right"] .jdgm-favicon + .jdgm-stars, .jdgm-revs-tab-btn[data-style=3D"=
stars"][position=3D"right"] .jdgm-stars + .jdgm-rating { margin-top: 8px; }

.jdgm-revs-tab-btn[data-style=3D"stars"][position=3D"left"] .jdgm-star, .jd=
gm-revs-tab-btn[data-style=3D"stars"][position=3D"right"] .jdgm-star { disp=
lay: block !important; padding: 0px !important; }

.jdgm-widget .jdgm-favicon[data-url=3D"/verified-checkmark.svg"] > img { wi=
dth: 17px; height: 17px; }

.jdgm-revs-tab { position: relative; z-index: 1041; }

.jdgm-revs-tab.jdgm-revs-tab { display: none; }

.jdgm-revs-tab .jdgm-branding-footer { color: white; }

.jdgm-revs-tab .jdgm-branding-footer:hover, .jdgm-revs-tab .jdgm-branding-f=
ooter:focus { color: white; }

.jdgm-revs-tab .jdgm-branding-footer:hover { opacity: 0.6; }

.jdgm-revs-tab__wrapper { position: fixed; inset: 0px; z-index: 99999999; }

.jdgm-revs-tab__wrapper.jdgm-revs-tab__wrapper { display: none; }

.jdgm-revs-tab__wrapper.jdgm-show { display: block; }

.jdgm-mask { width: 100%; height: 100%; background-color: black; opacity: 0=
.8; }

.jdgm-revs-tab__main, .jdgm-revs-tab__header { background: white; }

.jdgm-revs-tab__main, .jdgm-revs-tab__title { color: rgb(51, 51, 51); }

.jdgm-revs-tab__main { position: absolute; transform: translateX(-50%); top=
: 10%; left: 50%; height: 80%; width: 90%; max-width: 640px; }

.jdgm-revs-tab__header { height: 100px; padding: 16px 24px; text-align: cen=
ter; box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 30px; }

.jdgm-close-ico { position: absolute; right: 0px; top: -32px; width: 24px; =
height: 24px; }

.jdgm-close-ico:hover { opacity: 0.6; }

.jdgm-close-ico::before { transform: rotate(45deg); }

.jdgm-close-ico::after { transform: rotate(-45deg); }

.jdgm-close-ico::before, .jdgm-close-ico::after { position: absolute; conte=
nt: ""; height: 100%; width: 2px; background-color: white; }

.jdgm-revs-tab__title { margin-bottom: 0px; overflow: hidden; font-size: 12=
0%; }

.jdgm-revs-tab__content { height: calc(100% - 100px); padding: 24px; overfl=
ow: auto; }

.jdgm-revs-tab__content .jdgm-form__fieldset-actions { display: flex; flex-=
direction: column-reverse; }

.jdgm-revs-tab__content .jdgm-form__fieldset-actions .jdgm-btn { display: b=
lock; }

.jdgm-revs-tab__content .jdgm-form__fieldset-actions .jdgm-cancel-question,=
 .jdgm-revs-tab__content .jdgm-form__fieldset-actions .jdgm-cancel-rev { ma=
rgin-top: 10px; }

.jdgm-revs-tab__content-header { text-align: center; }

.jdgm-revs-tab__branding { text-align: center; line-height: 2; }

.jdgm-histogram-wrapper { margin-bottom: 24px; }

.jdgm-histogram-wrapper .jdgm-histogram { margin: 0px; }

.jdgm-histogram-wrapper .jdgm-histogram__bar { margin: 0px 16px; width: 128=
px; }

.jdgm-revs-tab__content-header .jdgm-row-media { padding: 24px 0px; }

.jdgm-revs-tab__content-header .jdgm-review-search-wrapper { padding: 0px; =
}

.jdgm-revs-tab__content-header .jdgm-review-search-wrapper::after { right: =
8px; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__header a.jdgm-revs-tab__url, .jd=
gm-widget.jdgm-revs-tab .jdgm-revs-tab__header a.jdgm-revs-tab__url:hover s=
pan { text-decoration: none; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__header a.jdgm-revs-tab__url span=
 { text-decoration: underline; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-row-stars {=
 display: block; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-row-media {=
 flex-direction: column; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-gallery-wra=
pper, .jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-medal=
s-wrapper { display: block; padding: 0px; text-align: center; border-top-wi=
dth: medium; border-top-style: none; border-top-color: currentcolor; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-gallery-wra=
pper + .jdgm-medals-wrapper { margin-top: 24px; padding: 24px 0px 0px; bord=
er-top: 1px solid var(--jdgm-secondary-color); border-left-width: medium; b=
order-left-style: none; border-left-color: currentcolor; }

.jdgm-widget.jdgm-revs-tab .jdgm-revs-tab__content-header .jdgm-medals__con=
tainer { overflow: auto; white-space: nowrap; margin-bottom: 0px; height: 1=
28px; }

@media only screen and (min-width: 768px) {
  .jdgm-histogram-wrapper .jdgm-histogram__bar { margin: 0px 24px; width: 1=
92px; }
  .jdgm-revs-tab__content .jdgm-form__fieldset-actions { display: block; }
  .jdgm-revs-tab__content .jdgm-form__fieldset-actions .jdgm-btn { margin-t=
op: 0px; display: inline-block; }
}

@media only screen and (max-width: 320px) {
  .jdgm-histogram-wrapper .jdgm-histogram__bar { margin: 0px 10px; width: 9=
6px; }
}

.jdgm-all-reviews-page__title, .jdgm-all-reviews__header { text-align: cent=
er; }

.jdgm-all-reviews-page__title { margin-top: 0px; margin-bottom: 12px; font-=
size: 150%; }

.jdgm-all-reviews-page__wrapper { margin: 0px auto; max-width: 90%; }

.jdgm-all-reviews-widget > .jdgm-spinner { margin: 24px auto; }

.jdgm-all-reviews__summary-text--verified { display: flex; align-items: cen=
ter; gap: 8px; justify-content: center; }

@media only screen and (min-width: 992px) {
  .jdgm-all-reviews__summary-text--verified { justify-content: flex-start; =
}
}

@media only screen and (min-width: 992px) {
  .jdgm-all-reviews-page__title { margin-bottom: 24px; }
  .jdgm-all-reviews-page__wrapper { max-width: 80%; }
}
