@-webkit-keyframes val {=20
  0% { opacity: 0; transform: translate3d(calc(-50% - 100vw), 0px, 0px); }
  50% { opacity: 0.5; transform: translate3d(100px, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes val {=20
  0% { opacity: 0; transform: translate3d(calc(-50% - 100vw), 0px, 0px); }
  50% { opacity: 0.5; transform: translate3d(100px, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

