  17% { animation-timing-function: cubic-bezier(0.755, 0.05, 0.855, 0.06); =
transform: translate3d(0px, -15px, 0px); }
  23% { transform: translate3d(0px, -4px, 0px); }
}

.ht-bounce { animation-name: ht-bounce; transform-origin: center bottom; }

@-webkit-keyframes ht-flash {=20
  12%, 6%, 0%, 100% { opacity: 1; }
  3%, 9% { opacity: 0; }
}

@keyframes ht-flash {=20
  12%, 6%, 0%, 100% { opacity: 1; }
  3%, 9% { opacity: 0; }
}

.ht-flash { animation-name: ht-flash; }

@-webkit-keyframes ht-rubberBand {=20
  25%, 0%, 100% { transform: scale3d(1, 1, 1); }
  7% { transform: scale3d(1.25, 0.75, 1); }
  10% { transform: scale3d(0.75, 1.25, 1); }
  12% { transform: scale3d(1.15, 0.85, 1); }
  16% { transform: scale3d(0.95, 1.05, 1); }
  18% { transform: scale3d(1.05, 0.95, 1); }
