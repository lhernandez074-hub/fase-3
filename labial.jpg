.ht-animated { animation-duration: 4s; animation-fill-mode: both; animation=
-delay: 1s; }

.ht-animated.ht-infinite { animation-iteration-count: infinite; }

@-webkit-keyframes ht-emitting {=20
  13% { box-shadow: rgba(0, 0, 0, 0.8) 0px 0px 5px 5px; }
  100%, 25% { box-shadow: rgba(0, 0, 0, 0.8) 0px 0px 0px 0px; }
}

