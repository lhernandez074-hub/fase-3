transform: translate3d(0px, -15px, 0px); }
  23% { transform: translate3d(0px, -4px, 0px); }
}

@keyframes ht-bounce {=20
  13%, 20%, 25%, 5%, 0%, 100% { animation-timing-function: cubic-bezier(0.2=
15, 0.61, 0.355, 1); transform: translate3d(0px, 0px, 0px); }
