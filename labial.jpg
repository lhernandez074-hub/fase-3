; height: 100%; opacity: 0; overflow-y: auto; padding: 2rem; position: fixe=
d; top: 0px; right: 0px; z-index: 4; transition: opacity var(--duration-def=
ault) ease,transform var(--duration-default) ease; transform: translate(100=
%); width: 100%; border-width: 0 0 0 var(--drawer-border-width); border-col=
or: rgba(var(--color-foreground),var(--drawer-border-opacity)); border-styl=
e: solid; filter: drop-shadow(var(--drawer-shadow-horizontal-offset) var(--=
drawer-shadow-vertical-offset) var(--drawer-shadow-blur-radius) rgba(var(--=
color-shadow),var(--drawer-shadow-opacity))); }

pickup-availability-drawer[open] { transform: translate(0px); opacity: 1; }

